# Routing shared by the dev stack (Caddyfile) and the production template (production/Caddyfile),
# so the two cannot drift apart. Any reverse proxy in front of Stalwart has to do these five things:
#   1. send Stalwart's paths to Stalwart, except /auth/callback, which is the app's;
#   2. take WWW-Authenticate off Stalwart's answers;
#   3. stream the push connection unbuffered, with no read timeout;
#   4. serve the app with its security headers, falling back to index.html;
#   5. compress the app's files, and only those.
(oinbox_routes) {
	# --- Paths owned by Stalwart (same origin as the SPA) --------------------
	# /auth/callback is the SPA's OAuth redirect_uri, so it must NOT go to Stalwart,
	# while every other /auth/* (token, device, introspect, userinfo, register, jwks.json) must.
	@stalwart {
		not path /auth/callback /auth/callback/*
		path /.well-known/* /jmap /jmap/* /auth/* /login /login/* /device /device/* /api/* /admin /admin/* /logo /healthz/*
	}
	handle @stalwart {
		# Stalwart's own pages (the sign-in form, its WebUI) send no security headers of their own.
		# The sign-in form above all must not be framed by another site.
		header {
			X-Frame-Options "DENY"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy stalwart:8080 {
			# A 401 with "WWW-Authenticate: Basic" makes browsers hold fetch() open behind a
			# native login prompt instead of returning the 401 to the SPA.
			header_down -Www-Authenticate
			# EventSource: stream immediately, never buffer.
			flush_interval -1
			transport http {
				read_timeout 0
			}
		}
	}

	# --- SPA ---------------------------------------------------------------
	handle {
		# Message iframes use srcdoc, which inherits this policy; each also sets its own
		# stricter CSP (remote images only after the user allows them), and the two intersect.
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: http:; font-src 'self' data:; connect-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
			Referrer-Policy "no-referrer"
			X-Content-Type-Options "nosniff"
		}
		# The app is one 870 kB script; compressed it is under a third of that. Only here: the
		# event stream in the block above must not be buffered by an encoder.
		encode zstd gzip
		@immutable path /assets/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		root * /srv/oinbox/dist
		try_files {path} /index.html
		file_server
	}
}
