# Copy to .env and fill in. Never commit .env.

# The host people open in a browser and point their mail apps at. Its DNS A/AAAA record must
# already reach this machine: Caddy asks Let's Encrypt for a certificate on first start.
OINBOX_DOMAIN=mail.example.com
# The part after @ in your addresses.
MAIL_DOMAIN=example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=postmaster@example.com

# The oinbox release to run (https://github.com/One-Learning-Community/oinbox/releases).
OINBOX_VERSION=0.1.0-beta.2

# Generate with: openssl rand -hex 32
MEILI_MASTER_KEY=

# Stalwart's recovery admin, as user:password. apply.sh uses it; so do you, to create accounts.
STALWART_RECOVERY_ADMIN=admin:

# Optional: your own name and logo in place of "oinbox" (docs/operating.md, "Branding").
# The logo is an https:// or data:image/... URL, or a path on this host. No double quotes or backquotes.
#OINBOX_BRAND_NAME=Example Mail
#OINBOX_BRAND_LOGO=https://example.com/logo.svg

# Optional: an OpenCloud beside Stalwart, used as Drive (docs/operating.md, "Drive").
# Where its HTTP listener is, as host:port reachable from the oinbox container.
#OINBOX_DRIVE_UPSTREAM=opencloud:9200
